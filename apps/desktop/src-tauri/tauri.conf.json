{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModelBridge",
  "version": "0.1.0",
  "identifier": "io.github.zacktools.modelbridge",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ModelBridge - Universal Local AI Gateway",
        "width": 960,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
